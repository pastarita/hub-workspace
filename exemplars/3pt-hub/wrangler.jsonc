{
  // 3PT hub workspace · Cloudflare Pages. Everything hub-related is cordoned under hub/.
  // The deploy artifact is hub/_site/ = site/ + ../docs/ + ../README.md + ../brainstorming.md,
  // built by tools/stage.sh so the Viewer can reach the docs of record.
  // Deploy from hub/ so functions/ (the gate) is compiled:
  //   make deploy   (= tools/stage.sh && npx wrangler pages deploy _site --project-name=3pt --branch=main)
  "name": "3pt",
  "compatibility_date": "2026-09-01",
  "pages_build_output_dir": "_site"
}
